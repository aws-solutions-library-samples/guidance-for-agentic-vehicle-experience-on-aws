        <!-- [14a] Connect → Customer (response back) -->
        <mxCell id="arrow-14a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;strokeColor=#248814;strokeWidth=2;rounded=0;fontFamily=Helvetica;exitX=0;exitY=0.7;entryX=1;entryY=0.15;dashed=0;" edge="1" parent="1" source="connect-container" target="customer-container">
