        <mxCell id="badge-11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=1;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="11" vertex="1" parent="1">
