        <!-- [10a] Runtime → DDB (dashed, write) -->
        <mxCell id="arrow-10a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;strokeColor=#545B64;strokeWidth=2;rounded=0;fontFamily=Helvetica;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="runtime-container" target="ddb-container">
