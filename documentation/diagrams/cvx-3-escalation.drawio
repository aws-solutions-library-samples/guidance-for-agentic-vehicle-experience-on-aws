        <mxCell id="legend-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;div&gt;&lt;b&gt;[10a]&lt;/b&gt; AgentCore Runtime → CVX operational DynamoDB (dashed write).&lt;/div&gt;&lt;div&gt;Persists escalation record to &lt;i&gt;vsa-escalation-records&lt;/i&gt; with priority (P0/P1/P2), triage inputs, tenant policy applied.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[10b]&lt;/b&gt; AgentCore Runtime → Amazon Connect (solid).&lt;/div&gt;&lt;div&gt;Emits &lt;i&gt;TransferContact&lt;/i&gt; (in-session) or &lt;i&gt;StartOutboundVoiceContact / StartOutboundChatContact&lt;/i&gt; (deferred callback) to Connect. Sets escalation context payload on the contact.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[11]&lt;/b&gt; Amazon Connect → Tier-2 Human Agent (solid).&lt;/div&gt;&lt;div&gt;Warm transfer: Customer Profiles enriches VehicleProfile + ServiceRecord. Agent Desktop Custom Views widget shows escalation context. Agent accepts and picks up the customer.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1510" y="195" width="445" height="640" as="geometry" />
        </mxCell>

