          <mxGeometry x="2020" y="140" width="720" height="1620" as="geometry" />
        </mxCell>

        <!-- Section A: Memory readers -->
        <mxCell id="legend-secA-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="A · AgentCore Memory readers (loaded at Phase 1)" vertex="1" parent="1">
          <mxGeometry x="2040" y="185" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secA-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr style=&quot;color: #01A88D; font-weight: bold; border-bottom: 1px solid #B2DFDB;&quot;&gt;&lt;td width=&quot;180&quot;&gt;Tool&lt;/td&gt;&lt;td&gt;Memory filter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;vehicle_identity()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=vehicle_identity, vehicle_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;service_history()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=service_records, vehicle_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;charging_history()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=charging_sessions, vehicle_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;customer_profile()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=customer_360, customer_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;interaction_history()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=customer_interactions, customer_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;ota_history()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;data_source=ota_campaigns, vehicle_id&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size: 10px; color: #01A88D; font-style: italic; margin-top: 4px;&quot;&gt;Rationale: session-init snapshot; values do not change during a session.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="220" width="680" height="300" as="geometry" />
        </mxCell>

        <!-- Section B: CMS operational -->
        <mxCell id="legend-secB-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C925D1;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="B · CMS operational state (session-cached or per-turn)" vertex="1" parent="1">
          <mxGeometry x="2040" y="530" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secB-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr style=&quot;color: #C925D1; font-weight: bold; border-bottom: 1px solid #E1BEE7;&quot;&gt;&lt;td width=&quot;140&quot;&gt;Tool&lt;/td&gt;&lt;td&gt;Data source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;triage()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Redis LKS snapshot (Phase-1) + tenant policy DDB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;book()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;CMS DDB &lt;code&gt;service-history&lt;/code&gt; &lt;b&gt;write&lt;/b&gt; + booking config&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;escalate()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;LKS+DDB snapshot + Amazon Connect queue ARN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size: 10px; color: #C925D1; font-style: italic; margin-top: 4px;&quot;&gt;Rationale: live vehicle state (read via Phase-1 cache); writes back to CMS.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="565" width="680" height="160" as="geometry" />
        </mxCell>

        <!-- Section C: ADP KB (cross-account) -->
        <mxCell id="legend-secC-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#01A88D;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="C · ADP Bedrock KB (cross-account Retrieve, per-turn)" vertex="1" parent="1">
          <mxGeometry x="2040" y="735" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secC-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr style=&quot;color: #01A88D; font-weight: bold; border-bottom: 1px solid #B2DFDB;&quot;&gt;&lt;td width=&quot;170&quot;&gt;Tool&lt;/td&gt;&lt;td&gt;source_category filter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;knowledge()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;persona-mapped (dtc_guide / tsb_recall / …)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;parts_lookup()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;parts_catalog&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;retrieve()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;caller-specified (any of 6 categories)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;diy_repair_advisor()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;local rules + &lt;code&gt;dtc_guide&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size: 10px; color: #01A88D; font-style: italic; margin-top: 4px;&quot;&gt;Rationale: reference content; KB is the source of truth. Filtered top-k keeps latency low.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="770" width="680" height="200" as="geometry" />
        </mxCell>

        <!-- Section D: Recalls -->
        <mxCell id="legend-secD-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="D · CMS Recalls Lambda (per-turn)" vertex="1" parent="1">
          <mxGeometry x="2040" y="985" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secD-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr style=&quot;color: #ED7100; font-weight: bold; border-bottom: 1px solid #FFE0B2;&quot;&gt;&lt;td width=&quot;180&quot;&gt;Tool&lt;/td&gt;&lt;td&gt;Data source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;recalls-lookup()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;NHTSA via CMS Recalls Lambda&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;recalls-status()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;NHTSA via CMS Recalls Lambda&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;recalls-timeline()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;NHTSA via CMS Recalls Lambda&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size: 10px; color: #ED7100; font-style: italic; margin-top: 4px;&quot;&gt;Rationale: freshness matters for open recall status; also factored into triage() P0-P3.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="1020" width="680" height="160" as="geometry" />
        </mxCell>

        <!-- Section E: What is NOT called per-turn -->
        <mxCell id="legend-secE-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D32F2F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="E · ✗ NOT called per turn (design invariant)" vertex="1" parent="1">
          <mxGeometry x="2040" y="1195" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secE-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family: Helvetica; font-size: 12px;&quot;&gt;&lt;tr style=&quot;color: #D32F2F; font-weight: bold; border-bottom: 1px solid #FFCDD2;&quot;&gt;&lt;td width=&quot;220&quot;&gt;Resource&lt;/td&gt;&lt;td&gt;Why not per-turn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ADP Athena / Glue / S3&lt;/td&gt;&lt;td&gt;Materialized to Memory at Phase 1; re-query is redundant.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CMS Redis LKS&lt;/td&gt;&lt;td&gt;Snapshot held in session context; stable point-in-time.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Lake Formation token vend&lt;/td&gt;&lt;td&gt;Only fetched during Phase 1 cross-account Athena call.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size: 10px; color: #D32F2F; font-style: italic; margin-top: 4px;&quot;&gt;Consequence: an N-turn session pays cross-account cost O(1), not O(N).&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="1230" width="680" height="150" as="geometry" />
        </mxCell>

        <!-- Section F: Arrow styles legend -->
        <mxCell id="legend-secF-header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" value="F · Arrow &amp; band conventions" vertex="1" parent="1">
          <mxGeometry x="2040" y="1395" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-secF-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;div&gt;&lt;span style=&quot;color: #FF8F00; font-weight: bold;&quot;&gt;━━▶ (thick amber)&lt;/span&gt; = Phase 1 session-init call (once per session)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #FF8F00; font-weight: bold;&quot;&gt;╌╌▶ (thick amber dashed)&lt;/span&gt; = Phase 1 write / return&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #00838F; font-weight: bold;&quot;&gt;━━▶ (thick teal)&lt;/span&gt; = Phase 2 per-turn read&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #C925D1; font-weight: bold;&quot;&gt;╌╌▶ (magenta dashed)&lt;/span&gt; = Phase 2 write (book())&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #999999; font-weight: bold;&quot;&gt;╌╌▶ (grey dashed)&lt;/span&gt; = in-process reference to cached state&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;span style=&quot;background: #FFF8E1; padding: 2px 6px;&quot;&gt;&amp;nbsp;amber band&amp;nbsp;&lt;/span&gt; = Phase 1 (session-init, ~6-7s)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background: #E0F7FA; padding: 2px 6px;&quot;&gt;&amp;nbsp;teal band&amp;nbsp;&lt;/span&gt; = Phase 2 (per-turn, ~10-100ms)&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="2045" y="1430" width="680" height="300" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
