        <mxCell id="p2-kb-container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#01A88D;fontSize=12;fontStyle=1;fontColor=#01A88D;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=70;spacingTop=10;strokeWidth=1.5;shadow=1;container=1;collapsible=0;" value="Bedrock Knowledge Base" vertex="1" parent="p2-adp-account">
