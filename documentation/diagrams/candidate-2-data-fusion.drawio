        <mxCell id="p2-kb-sublist" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;div&gt;&lt;b&gt;Cross-account Retrieve · resource policy grants CVX role&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-family: monospace; font-size: 10px; color: #01A88D; margin-top: 4px;&quot;&gt;filter: source_category={category}&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;· &lt;code style=&quot;font-family: monospace;&quot;&gt;knowledge()&lt;/code&gt; — any category, per persona&lt;/div&gt;&lt;div&gt;· &lt;code style=&quot;font-family: monospace;&quot;&gt;parts_lookup()&lt;/code&gt; — parts_catalog&lt;/div&gt;&lt;div&gt;· &lt;code style=&quot;font-family: monospace;&quot;&gt;retrieve()&lt;/code&gt; — dtc_guide, tsb_recall, owner_manual, service_policy, charging_narrative&lt;/div&gt;&lt;div&gt;· &lt;code style=&quot;font-family: monospace;&quot;&gt;diy_repair_advisor()&lt;/code&gt; — local rules + dtc_guide&lt;/div&gt;&lt;div style=&quot;margin-top: 4px; font-size: 10px; color: #666;&quot;&gt;&lt;i&gt;SigV4 signed; validated in ADP account; audited in ADP CloudTrail.&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="p2-kb-container">
