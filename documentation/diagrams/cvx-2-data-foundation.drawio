        <mxCell id="badge-8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=1;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="8" vertex="1" parent="1">
          <mxGeometry x="440" y="925" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="badge-9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=1;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="9" vertex="1" parent="1">
          <mxGeometry x="595" y="750" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- ===== Legend on the right ===== -->
        <mxCell id="legend-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6C8EBF;strokeWidth=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=10;spacingLeft=20;fontSize=16;fontStyle=1;fontColor=#232F3E;" value="Numbered flow steps" vertex="1" parent="1">
          <mxGeometry x="1740" y="150" width="820" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="legend-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;div&gt;&lt;b&gt;[3]&lt;/b&gt; Per-turn entry: Supervisor Lambda (Diagram 1) invokes AgentCore Runtime with the user's turn payload.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[4a]&lt;/b&gt; Runtime → CMS Redis LKS. Session-init: reads latest known state for the target vehicle (DTCs, telemetry, HVAC, tires, location).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[4b]&lt;/b&gt; Runtime → Centralized Data Repository (ADP). Session-init: reads historical aggregates (Athena over Glue/S3, governed by Lake Formation). Crosses cross-account boundary.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[4c]&lt;/b&gt; Runtime → AgentCore Memory (write, dashed). Session-init: writes context, owner facts, prior contact refs for LTM.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[6]&lt;/b&gt; Runtime → AgentCore Memory. Per-turn read: retrieves customer preferences, prior context.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[7]&lt;/b&gt; Runtime → Bedrock Knowledge Base (Retrieve). Per-turn: filtered top-k retrieval by source_category (dtc_guide, service_manual, etc.). Crosses cross-account boundary.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[8]&lt;/b&gt; Runtime → CMS Recalls Lambda. Per-turn: recalls-lookup, recalls-status, recalls-timeline tool calls.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;[9]&lt;/b&gt; Runtime → CMS DynamoDB (write, dashed). Per-turn: book() writes to service-history when customer confirms appointment.&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="1760" y="195" width="785" height="990" as="geometry" />
        </mxCell>

        <!-- ===== Line styles / arrow legend ===== -->
        <mxCell id="line-styles-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=10;spacingLeft=20;fontSize=13;fontStyle=1;fontColor=#232F3E;" value="Arrow styles" vertex="1" parent="1">
          <mxGeometry x="80" y="1370" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="line-styles-body" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Helvetica;fontColor=#232F3E;" value="&lt;div&gt;━━&gt; solid: read / synchronous call&lt;/div&gt;&lt;div&gt;╌╌&gt; dashed: async / write&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;← Diagram N&lt;/i&gt; off-diagram tag&lt;/div&gt;" vertex="1" parent="1">
          <mxGeometry x="95" y="1405" width="300" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
