# ─── Required: CMS Integration ───────────────────────────────────────────────
# The deployment stage of your Connected Mobility (CMS) deployment.
# Table names are derived as: cms-{CMS_STAGE}-storage-vehicles, etc.
CMS_STAGE=dev

# KMS key ARN used by CMS DynamoDB tables (SSE-KMS encryption).
# Find this in your CMS deployment outputs or AWS KMS console.
CMS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/your-key-id

# Redis endpoint from the CMS MSK stack (vehicle live state).
REDIS_ENDPOINT=your-redis-cluster.abc123.use1.cache.amazonaws.com

# ─── Required: AWS ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123456789012

# ─── VFO Deployment ─────────────────────────────────────────────────────────
VSA_STAGE=prod

# ─── Agent Supervisor (for local dev / AgentCore runtime) ────────────────────
# These are populated after `cdk deploy` from stack outputs.
VSA_API_BASE=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VSA_TENANT_ID=michelin
VSA_COGNITO_POOL_ID=<user-pool-id>
VSA_COGNITO_CLIENT_ID=your-cognito-client-id

# Demo user sign-in for local dev.
#
# There is no shared demo password. Every seeded account has its own value,
# generated at seed time and stored in Secrets Manager as a JSON map keyed by
# email, in `vsa-<stage>-michelin-demo-passwords`. Retrieve yours with:
#
#   aws secretsmanager get-secret-value \
#     --secret-id vsa-<stage>-michelin-demo-passwords \
#     --region <stage-region> --query SecretString --output text \
#     | python3 -c 'import json,sys; print(json.load(sys.stdin)["<your-email>"])'
#
# ...or re-issue one by running `scripts/seed-persona-users.py`, which prints the
# freshly generated password for the account it creates. Background:
# issues/2026-08-03-cvx-demo-password-rotation/.
#
# Which account to use depends on the stage, and they are NOT symmetric:
#   * The username below is seeded by `scripts/seed-michelin-user.py`, which
#     defaults to STAGE=prod — so it exists in the PROD tenant pool only.
#   * The staging pool is seeded by `scripts/seed-persona-users.py` with the
#     persona accounts instead (ford.driver@example.com, enterprise.driver@example.com,
#     service.advisor@example.com, technician@example.com, vehicle.owner@example.com,
#     samantha.carter@example.com, ...). Prefer one of these for day-to-day dev
#     rather than signing in as a production account.
VSA_DEMO_USERNAME=demo@michelin.example
VSA_DEMO_PASSWORD=

# Demo vehicle identity (from CMS seeded data)
VSA_DEFAULT_VIN=your-vin
VSA_DEFAULT_VEHICLE_ID=VEH-XXXX
VSA_DEFAULT_DRIVER_ID=DRV-XXXX

# ─── Optional ────────────────────────────────────────────────────────────────
# Bedrock model for the supervisor agent
VSA_SUPERVISOR_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# CVX-on-foundation v1 persona-loader config (Group 4.B)
# ---------------------------------------------------------------------------
VSA_FOUNDATION_MEMORY_ID=             # REQUIRED: AgentCore Memory ID for this deployment
VSA_ADP_ACCOUNT_ID=                   # ADP AWS account ID (default: caller account via STS)
VSA_ADP_REGION=us-east-1             # Region where ADP Lake Formation + Athena live
VSA_ADP_STAGE=staging                # ADP deployment stage (staging | prod)
VSA_ATHENA_WORKGROUP=                 # Athena workgroup (default: cvx-{stage}-analytics)
VSA_ATHENA_RESULTS_BUCKET=            # Athena results bucket (default: cvx-{stage}-athena-results-{account}-us-east-1)
VSA_PERSONA_LTM_TTL_MIN=15           # LTM cache TTL in minutes (default: 15)
VSA_ADP_KB_ID=                        # Bedrock KB ID for cross-account Retrieve (empty = KB disabled)
VSA_MEMORY_REGION=us-west-2          # AgentCore Memory region (default: us-west-2)
